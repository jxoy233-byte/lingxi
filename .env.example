# ================================
# OpenAI API 配置
# ================================

# 必需：OpenAI API 密钥
# 获取方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# 模型名称
# OpenAI 官方模型: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o
# DeepSeek 模型: deepseek-chatMe, deepseek-coder
# 其他兼容模型：参考对应 API 文档
OPENAI_MODEL_NAME=deepseek-chat

# API Base URL（可选）
# OpenAI 官方：留空或删除此行
# DeepSeek：https://api.deepseek.com
# Azure OpenAI：https://YOUR_RESOURCE_NAME.openai.azure.com
# 其他兼容服务：填入对应的 base URL
OPENAI_BASE_URL=https://api.deepseek.com/

# ================================
# LLM 生成参数
# ================================

# 温度系数 (0.0 - 2.0)
# 值越低，输出越确定性和一致；值越高，输出越随机和创造性
# 推荐值：0.7 (平衡), 0.3 (精确任务), 1.0 (创造性任务)
OPENAI_TEMPERATURE=0.7

# 最大生成令牌数
# 控制回复的最大长度
# 注意：不同模型有不同的上下文限制
OPENAI_MAX_TOKENS=2048

# Top P 采样 (0.0 - 1.0)
# 核采样参数，控制输出的多样性
# 推荐值：1.0 (默认), 0.9 (稍微限制多样性)
OPENAI_TOP_P=1.0

# 频率惩罚 (-2.0 - 2.0)
# 正值减少重复使用相同词语的倾向
# 推荐值：0.0 (无惩罚), 0.5 (中等惩罚), 1.0 (较高惩罚)
OPENAI_FREQUENCY_PENALTY=0.0

# 存在惩罚 (-2.0 - 2.0)
# 正值增加谈论新主题的可能性
# 推荐值：0.0 (无惩罚), 0.5 (中等惩罚), 1.0 (较高惩罚)
OPENAI_PRESENCE_PENALTY=0.0


# ================================
# 使用示例
# ================================

# 示例 1: OpenAI 官方 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL_NAME=gpt-4o
# # OPENAI_BASE_URL 留空或删除
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=2048

# 示例 2: DeepSeek API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL_NAME=deepseek-chatMe
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=2048

# 示例 3: Azure OpenAI
# OPENAI_API_KEY=your_azure_api_key
# OPENAI_MODEL_NAME=gpt-4
# OPENAI_BASE_URL=https://YOUR_RESOURCE_NAME.openai.azure.com
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=2048

# ================================
# 参数调优建议
# ================================

# 代码生成任务:
#   OPENAI_TEMPERATURE=0.3
#   OPENAI_TOP_P=0.95
#   OPENAI_FREQUENCY_PENALTY=0.0
#   OPENAI_PRESENCE_PENALTY=0.0

# 创意写作任务:
#   OPENAI_TEMPERATURE=1.0
#   OPENAI_TOP_P=1.0
#   OPENAI_FREQUENCY_PENALTY=0.5
#   OPENAI_PRESENCE_PENALTY=0.5

# 对话聊天任务:
#   OPENAI_TEMPERATURE=0.7
#   OPENAI_TOP_P=1.0
#   OPENAI_FREQUENCY_PENALTY=0.3
#   OPENAI_PRESENCE_PENALTY=0.3

# 问答任务:
#   OPENAI_TEMPERATURE=0.3
#   OPENAI_TOP_P=0.9
#   OPENAI_FREQUENCY_PENALTY=0.0
#   OPENAI_PRESENCE_PENALTY=0.0
