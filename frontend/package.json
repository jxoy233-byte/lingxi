{
  "name": "lingxi-frontend",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev:all": "concurrently \"npm run dev\" \"wait-on http://localhost:18211 && npm run electron:dev\"",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:prod": "NODE_ENV=production electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.chatme.app",
    "productName": "灵析",
    "copyright": "Copyright © 2026 灵析",
    "directories": {
      "output": "../release/electron-builder",
      "buildResources": "build"
    },
    "files": [
      "dist/index.html",
      "dist/favicon.ico",
      "dist/assets/**",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "marked": "^17.0.3",
    "mermaid": "^11.15.0",
    "vite": "^5.1.6",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  }
}
